// Prisma Schema for PostgreSQL Database

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 产品管理模块
model Product {
  id          String   @id @default(uuid())
  name        String
  description String
  price       Float
  category    String
  images      Json?    // 图片URL数组（JSON格式）
  content     Json?    // 拖拽编辑器保存的富文本内容（JSON格式）
  layout      Json?    // 页面布局配置（JSON格式）
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([isActive])
  @@map("products")
}

// 新闻资讯模块
model News {
  id          String   @id @default(uuid())
  title       String
  summary     String
  content     Json?    // 拖拽编辑器保存的富文本内容（JSON格式）
  layout      Json?    // 页面布局配置（JSON格式）
  coverImage  String?
  author      String
  category    String
  tags        Json?    // 标签数组（JSON格式）
  isPublished Boolean  @default(false)
  publishedAt DateTime?
  viewCount   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isPublished])
  @@index([category])
  @@index([publishedAt])
  @@map("news")
}

// 表单提交模块
model FormSubmission {
  id         String   @id @default(uuid())
  formType   String   // 表单类型：contact, inquiry, feedback等
  data       Json     // 表单数据（JSON格式，灵活存储）
  status     String   @default("pending") // pending, processed, archived
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  
  @@index([formType])
  @@index([status])
  @@map("form_submissions")
}

// 客服对话模块
model ChatSession {
  id           String   @id @default(uuid())
  sessionId    String   @unique // 会话ID
  userId       String?  // 用户ID（可选）
  messages     Json     // 对话消息数组
  status       String   @default("active") // active, closed, transferred
  metadata     Json?    // 额外元数据
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  lastMessageAt DateTime @default(now())
  
  @@index([sessionId])
  @@index([status])
  @@map("chat_sessions")
}
