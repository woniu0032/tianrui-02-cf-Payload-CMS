# 构建阶段
FROM node:20-alpine AS builder

WORKDIR /app

# 安装 pnpm
RUN npm install -g pnpm

# 复制依赖文件
COPY package.json pnpm-lock.yaml ./

# 安装依赖
RUN pnpm install --frozen-lockfile

# 复制源代码
COPY . .

# 生成 importmap
RUN pnpm generate:importmap

# 构建
RUN pnpm build

# 输出阶段
FROM alpine:latest
WORKDIR /output
COPY --from=builder /app/.next ./.next
